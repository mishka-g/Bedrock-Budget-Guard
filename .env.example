# Local demo (ministack). Copy to .env:
#   cp .env.example .env
AWS_ENDPOINT_URL=http://ministack:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=eu-west-1

# Optional Slack Incoming Webhook (also set alerts.slack.enabled: true in config).
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Real AWS: omit AWS_ENDPOINT_URL (or leave it unset) and use real credentials
# via env, ~/.aws, or an IAM role. Example:
#   # AWS_ENDPOINT_URL=
#   AWS_ACCESS_KEY_ID=...
#   AWS_SECRET_ACCESS_KEY=...
#   AWS_DEFAULT_REGION=eu-west-1
