# Real AWS credentials for docker compose -f docker-compose.aws.yaml
#   cp .env.aws.example .env.aws
#
# Do NOT set AWS_ENDPOINT_URL (real AWS endpoints only).

AWS_DEFAULT_REGION=eu-west-1

# Option A — access keys (or temporary session creds)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Option B — leave keys empty, uncomment ~/.aws mount in docker-compose.aws.yaml,
# and set a profile name:
# AWS_PROFILE=default
