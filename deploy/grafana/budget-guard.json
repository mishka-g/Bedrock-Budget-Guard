{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "title": "FinOps",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 2,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "budget_guard_spend_usd and on(instance) (budget_guard_is_leader == 1)",
          "legendFormat": "{{project}} spend",
          "refId": "A"
        },
        {
          "expr": "budget_guard_budget_usd and on(instance) (budget_guard_is_leader == 1)",
          "legendFormat": "{{project}} budget",
          "refId": "B"
        }
      ],
      "title": "Spend vs budget (UTC day)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1.5,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.8 },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 3,
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "expr": "budget_guard_spend_ratio and on(instance) (budget_guard_is_leader == 1)",
          "legendFormat": "{{project}}",
          "refId": "A"
        }
      ],
      "title": "Budget used",
      "type": "gauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "color": "green", "text": "open" }, "1": { "color": "red", "text": "blocked" } }, "type": "value" }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 9 },
      "id": 4,
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "expr": "budget_guard_blocked and on(instance) (budget_guard_is_leader == 1)",
          "legendFormat": "{{project}}",
          "refId": "A"
        }
      ],
      "title": "Blocked",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "color": "yellow", "text": "off" }, "1": { "color": "blue", "text": "enforce" } }, "type": "value" }
          ]
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 9 },
      "id": 5,
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "expr": "budget_guard_enforce and on(instance) (budget_guard_is_leader == 1)",
          "legendFormat": "{{project}}",
          "refId": "A"
        }
      ],
      "title": "Enforce",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "unit": "currencyUSD", "decimals": 2 }
      },
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 9 },
      "id": 6,
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "expr": "budget_guard_unconfigured_spend_usd and on(instance) (budget_guard_is_leader == 1)",
          "legendFormat": "{{project}}",
          "refId": "A"
        }
      ],
      "title": "Unconfigured project spend",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 },
      "id": 10,
      "title": "Guard health",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "color": "red", "text": "standby" }, "1": { "color": "green", "text": "leader" } }, "type": "value" }
          ]
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 14 },
      "id": 11,
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "expr": "budget_guard_is_leader",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "title": "Leader",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "unit": "s" }
      },
      "gridPos": { "h": 6, "w": 9, "x": 6, "y": 14 },
      "id": 12,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }
      },
      "targets": [
        {
          "expr": "budget_guard_watermark_lag_seconds and on(instance) (budget_guard_is_leader == 1)",
          "legendFormat": "lag",
          "refId": "A"
        }
      ],
      "title": "Watermark lag",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "gridPos": { "h": 6, "w": 9, "x": 15, "y": 14 },
      "id": 13,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }
      },
      "targets": [
        {
          "expr": "rate(budget_guard_log_fetch_errors_total[5m])",
          "legendFormat": "log fetch errors",
          "refId": "A"
        },
        {
          "expr": "rate(budget_guard_iam_put_failures_total[5m])",
          "legendFormat": "IAM put failures",
          "refId": "B"
        },
        {
          "expr": "rate(budget_guard_state_save_errors_total[5m])",
          "legendFormat": "state save errors",
          "refId": "C"
        }
      ],
      "title": "Fail-open error rates",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "unit": "s" }
      },
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 20 },
      "id": 14,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(budget_guard_poll_duration_seconds_bucket[5m]))",
          "legendFormat": "p95 poll",
          "refId": "A"
        }
      ],
      "title": "Poll duration p95",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 20 },
      "id": 15,
      "targets": [
        {
          "expr": "increase(budget_guard_unpriced_events_total[1h])",
          "legendFormat": "{{model_id}}",
          "refId": "A"
        }
      ],
      "title": "Unpriced events (undercount risk)",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["bedrock", "finops", "sre"],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "label": "Datasource",
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "type": "datasource"
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "utc",
  "title": "Bedrock Budget Guard",
  "uid": "budget-guard",
  "version": 1
}
